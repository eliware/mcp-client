# Example values for mcp-client examples.
# The package does not load .env files. Set these values in the process environment.

# MCP server URL (default: http://localhost:1234/mcp)
MCP_URL=http://localhost:1234/mcp

# MCP server port (default: 1234)
MCP_PORT=1234

# Optional bearer token for an MCP server
MCP_TOKEN=your-mcp-token-here

# Required only for the stdio example.
MCP_COMMAND=node
MCP_ARGS=["/path/to/your/server.mjs","--stdio"]
